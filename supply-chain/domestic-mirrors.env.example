# Copy to a protected operator environment file. Do not commit credentials.
#
# Module/package mirrors are acquisition channels only. go.sum and npm lock
# integrity remain authoritative and the release gate rejects drift.
GOPROXY=https://goproxy.cn,direct
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Copy each OCI image into the approved domestic registry without rewriting its
# manifest. Then set the three Docker build arguments to the mirrored reference
# with the SAME sha256 digest from production-inputs.json.
TRUSTDB_OCI_MIRROR_PREFIX=registry.example.cn/trustdb-mirror
NODE_IMAGE=registry.example.cn/trustdb-mirror/node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
GO_IMAGE=registry.example.cn/trustdb-mirror/golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
RUNTIME_IMAGE=registry.example.cn/trustdb-mirror/debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
